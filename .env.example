# AWS Configuration
AWS_PROFILE=default
AWS_REGION=us-east-1

# Mocking Toggle (Set to 'true' to bypass live AWS calls)
MOCK_AWS=true

# Git / GitHub Configuration
# Leave GITHUB_TOKEN empty to use local git CLI commands fallback
GITHUB_TOKEN=
REPO_PATH=G:/hacathon/cloud-waste-sniper
REPO_NAME=yourusername/cloud-waste-sniper # Used if PyGithub is active
